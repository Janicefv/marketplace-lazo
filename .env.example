# Copia este archivo como .env para desarrollo local. En Vercel, crea las mismas variables en
# Project Settings > Environment Variables.

# PostgreSQL. En Vercel: base Neon desde Storage/Marketplace (usa la cadena con "-pooler").
DATABASE_URL=postgres://postgres@localhost:5432/c2c

# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios (obligatorio en producción).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración de la sesión en segundos (2 horas por defecto).
JWT_TTL_SECONDS=7200

# Imágenes: sin esta variable se guardan en ./uploads (solo local). En Vercel es obligatoria.
# Formato: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Pagos: "simulated" (sandbox incluido) o "mercadopago" (Checkout Pro).
PAYMENT_PROVIDER=simulated
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URL pública del sitio (en Vercel se calcula sola).
APP_URL=http://localhost:3000

# Minutos que un producto queda reservado mientras el comprador paga.
RESERVATION_MINUTES=15
